{
  "$defs": {
    "Call": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/CallKind",
          "description": "`query`: asks the world and gets a response. `command`: acts on the\nworld, no response. Both are checked in order."
        },
        "request": {
          "additionalProperties": {
            "$ref": "#/$defs/Field"
          },
          "default": {},
          "type": "object"
        },
        "response": {
          "additionalProperties": {
            "$ref": "#/$defs/Field"
          },
          "description": "Queries only.",
          "type": "object"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "CallKind": {
      "enum": [
        "query",
        "command"
      ],
      "type": "string"
    },
    "Field": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "int"
              }
            }
          },
          "then": {
            "required": [
              "bits",
              "signed"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fixed"
              }
            }
          },
          "then": {
            "required": [
              "signed",
              "int_bits",
              "frac_bits"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            }
          },
          "then": {
            "required": [
              "variants"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "float"
              }
            }
          },
          "then": {
            "required": [
              "bits"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            }
          },
          "then": {
            "required": [
              "of",
              "len"
            ]
          }
        }
      ],
      "description": "A field's declared type, as written in `mechanic.toml` and interfaces.\nWhich keys apply depends on `type`; [`Field::ty`] checks them.",
      "properties": {
        "bits": {
          "description": "`int`: width in bits (1 to 64). `float`: 32, 64 or 80.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "frac_bits": {
          "description": "`fixed`: fraction bits; the raw value is the real value × 2^frac_bits.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "int_bits": {
          "description": "`fixed`: integer bits, the sign bit included.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "len": {
          "description": "`table`: the number of elements.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "of": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field"
            },
            {
              "type": "null"
            }
          ],
          "description": "`table`: the element type (not itself a table)."
        },
        "signed": {
          "description": "`int`, `fixed`: whether the value is two's complement.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "type": {
          "$ref": "#/$defs/Kind"
        },
        "unit": {
          "description": "Documentation only: `\"units\"`, `\"units/tick\"`, `\"angle/4096\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "variants": {
          "description": "`enum`: the variants' names.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "Kind": {
      "oneOf": [
        {
          "enum": [
            "bool",
            "int",
            "fixed",
            "enum",
            "float"
          ],
          "type": "string"
        },
        {
          "const": "table",
          "description": "Params only: a fixed-length list of one element type.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "calls": {
      "additionalProperties": {
        "$ref": "#/$defs/Call"
      },
      "type": "object"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "description": "Broad to narrow: `world.floor-height`; also the file's name.",
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "description": "Bumped on any change to the calls; mechanics require `<id>@<version>`.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "id",
    "version",
    "title",
    "calls"
  ],
  "title": "interfaces/<id>.toml",
  "type": "object"
}
