{
  "$defs": {
    "Begin": {
      "additionalProperties": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "description": "A step begins when this PC runs, with every register filter matching.",
      "properties": {
        "overlay": {
          "type": [
            "string",
            "null"
          ]
        },
        "pc": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "pc"
      ],
      "type": "object"
    },
    "CallBinding": {
      "additionalProperties": false,
      "description": "How capture sees one interface call: where it happens, and where the\nrequest and response are read.",
      "properties": {
        "on": {
          "$ref": "#/$defs/CallSite"
        },
        "request": {
          "additionalProperties": {
            "$ref": "#/$defs/Read"
          },
          "type": "object"
        },
        "response": {
          "additionalProperties": {
            "$ref": "#/$defs/Read"
          },
          "type": "object"
        }
      },
      "required": [
        "on"
      ],
      "type": "object"
    },
    "CallSite": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "A routine entered at this PC: the request is read at entry, the\nresponse when it returns to its caller.",
          "properties": {
            "entry": {
              "$ref": "#/$defs/Pc"
            }
          },
          "required": [
            "entry"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A load at this PC that asks the world inline (a table lookup): the\nrequest is what is loaded from, the response what is loaded.",
          "properties": {
            "read": {
              "$ref": "#/$defs/Pc"
            }
          },
          "required": [
            "read"
          ],
          "type": "object"
        }
      ],
      "description": "How capture sees an interface call."
    },
    "Capture": {
      "additionalProperties": false,
      "properties": {
        "begin": {
          "$ref": "#/$defs/Begin"
        },
        "end": {
          "$ref": "#/$defs/End"
        },
        "explained": {
          "description": "Reads the step makes that the binding deliberately leaves out, and why.",
          "items": {
            "$ref": "#/$defs/Explained"
          },
          "type": "array"
        }
      },
      "required": [
        "begin",
        "end"
      ],
      "type": "object"
    },
    "Data": {
      "additionalProperties": false,
      "description": "A table, list or record param as it lies in memory: where it starts,\nand its layout from there.",
      "properties": {
        "at": {
          "$ref": "#/$defs/Location"
        },
        "follow": {
          "description": "Pointers to follow from `at` first: at each offset in turn, the\naddress held there (a 4-byte word) becomes the base.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "layout": {
          "$ref": "#/$defs/Layout"
        }
      },
      "required": [
        "at",
        "layout"
      ],
      "type": "object"
    },
    "Elements": {
      "additionalProperties": false,
      "description": "A table's or list's elements.",
      "properties": {
        "count": {
          "anyOf": [
            {
              "$ref": "#/$defs/Read2"
            },
            {
              "type": "null"
            }
          ],
          "description": "A list's length, read from the base (a table's is its type's)."
        },
        "follow": {
          "description": "Pointers to follow from the base to the elements, as `Data::follow`.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "of": {
          "$ref": "#/$defs/Layout",
          "description": "Each element, from its own start."
        },
        "offset": {
          "default": 0,
          "description": "Where the first element starts, after `follow`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "stride": {
          "description": "Bytes from one element to the next.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "stride",
        "of"
      ],
      "type": "object"
    },
    "Encoding": {
      "anyOf": [
        {
          "$ref": "#/$defs/Read"
        },
        {
          "$ref": "#/$defs/Unobserved"
        }
      ],
      "description": "A state field's encoding, or why it cannot be read."
    },
    "End": {
      "anyOf": [
        {
          "$ref": "#/$defs/Pc",
          "description": "When this PC runs."
        },
        {
          "$ref": "#/$defs/EndMode",
          "description": "`next_begin`: at the next begin. `frame`: at the next vblank."
        }
      ]
    },
    "EndMode": {
      "enum": [
        "next_begin",
        "frame"
      ],
      "type": "string"
    },
    "Endian": {
      "enum": [
        "big",
        "little"
      ],
      "type": "string"
    },
    "Explained": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where: `bytes` from this location."
        },
        "by": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pc"
            },
            {
              "type": "null"
            }
          ],
          "description": "Or by whom: every load this instruction makes, wherever it reads\n(level data whose address changes from level to level)."
        },
        "bytes": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "why": {
          "type": "string"
        }
      },
      "required": [
        "why"
      ],
      "type": "object"
    },
    "Layout": {
      "anyOf": [
        {
          "$ref": "#/$defs/Read2"
        },
        {
          "$ref": "#/$defs/Elements"
        },
        {
          "$ref": "#/$defs/RecordLayout"
        }
      ],
      "description": "Where a value lies relative to a base address: a field read at\noffsets, a table or list of elements, or a record of fields."
    },
    "Load": {
      "enum": [
        "address",
        "value"
      ],
      "type": "string"
    },
    "Location": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "Main RAM (any segment) or the scratchpad (0x1F800000).",
          "properties": {
            "address": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "address"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Relative to a register's value latched at the bracket's begin.",
          "properties": {
            "base": {
              "$ref": "#/$defs/Reg"
            },
            "offset": {
              "format": "int32",
              "type": "integer"
            }
          },
          "required": [
            "base",
            "offset"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A CPU register: at begin (inputs, params), at a call's entry\n(request) or return (response).",
          "properties": {
            "register": {
              "$ref": "#/$defs/Reg"
            }
          },
          "required": [
            "register"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A GTE register: data 0 to 31 as `mfc2` numbers them, control 32 to 63\n(`cfc2` n is 32 + n).",
          "properties": {
            "gte": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "gte"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An inline read's (`on = { read }`) address (request) or loaded value\n(response).",
          "properties": {
            "load": {
              "$ref": "#/$defs/Load"
            }
          },
          "required": [
            "load"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Glossary quantities: the address held at `pointer`, plus `offset`,\nread anew each time (an object found through a pointer).",
          "properties": {
            "offset": {
              "format": "int32",
              "type": "integer"
            },
            "pointer": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "pointer",
            "offset"
          ],
          "type": "object"
        }
      ],
      "description": "Where a value is."
    },
    "Offset": {
      "additionalProperties": false,
      "description": "An offset from the base address.",
      "properties": {
        "offset": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "offset"
      ],
      "type": "object"
    },
    "Param": {
      "anyOf": [
        {
          "$ref": "#/$defs/Read"
        },
        {
          "$ref": "#/$defs/Data"
        },
        {
          "$ref": "#/$defs/Value"
        }
      ],
      "description": "A param: where to read it, how its data lies in memory, or its value."
    },
    "Part": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "$ref": "#/$defs/Location"
        },
        "bytes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "at",
        "bytes"
      ],
      "type": "object"
    },
    "Part2": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "$ref": "#/$defs/Offset"
        },
        "bytes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "at",
        "bytes"
      ],
      "type": "object"
    },
    "Pc": {
      "additionalProperties": false,
      "description": "A PC, with the overlay it is in when it is not in resident code. The\noverlay is named as `psx inventory` names it.",
      "properties": {
        "overlay": {
          "type": [
            "string",
            "null"
          ]
        },
        "pc": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "pc"
      ],
      "type": "object"
    },
    "Read": {
      "additionalProperties": false,
      "description": "How a field's raw value is read: each part in order, first part most\nsignificant, then `mask`, `shift`, sign extension, rescaling and `map`.",
      "properties": {
        "endian": {
          "anyOf": [
            {
              "$ref": "#/$defs/Endian"
            },
            {
              "type": "null"
            }
          ],
          "description": "The parts' byte order; the platform's when left out."
        },
        "map": {
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          },
          "description": "`enum` (required) and `bool`: stored integer (decimal) -> value.",
          "type": [
            "object",
            "null"
          ]
        },
        "mask": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ],
          "description": "Applied to the concatenated parts, before `shift`."
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/Part"
          },
          "type": "array"
        },
        "shift": {
          "description": "Right shift after `mask`.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "stored_frac_bits": {
          "description": "`fixed`: the stored fraction bits, when they differ from the\nmechanic's. Capture refuses a rescale that loses bits.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "stored_signed": {
          "description": "Sign-extend from the read width (the mask's, or the parts').",
          "type": "boolean"
        },
        "stride": {
          "description": "Table params: bytes from one element to the next; the parts read\nthe first. Defaults to the parts' size.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "parts"
      ],
      "type": "object"
    },
    "Read2": {
      "additionalProperties": false,
      "description": "How a field's raw value is read: each part in order, first part most\nsignificant, then `mask`, `shift`, sign extension, rescaling and `map`.",
      "properties": {
        "endian": {
          "anyOf": [
            {
              "$ref": "#/$defs/Endian"
            },
            {
              "type": "null"
            }
          ],
          "description": "The parts' byte order; the platform's when left out."
        },
        "map": {
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          },
          "description": "`enum` (required) and `bool`: stored integer (decimal) -> value.",
          "type": [
            "object",
            "null"
          ]
        },
        "mask": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ],
          "description": "Applied to the concatenated parts, before `shift`."
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/Part2"
          },
          "type": "array"
        },
        "shift": {
          "description": "Right shift after `mask`.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "stored_frac_bits": {
          "description": "`fixed`: the stored fraction bits, when they differ from the\nmechanic's. Capture refuses a rescale that loses bits.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "stored_signed": {
          "description": "Sign-extend from the read width (the mask's, or the parts').",
          "type": "boolean"
        },
        "stride": {
          "description": "Table params: bytes from one element to the next; the parts read\nthe first. Defaults to the parts' size.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "parts"
      ],
      "type": "object"
    },
    "RecordLayout": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "additionalProperties": {
            "$ref": "#/$defs/Layout"
          },
          "type": "object"
        }
      },
      "required": [
        "fields"
      ],
      "type": "object"
    },
    "Reg": {
      "description": "A CPU register, by its conventional name.",
      "enum": [
        "zero",
        "at",
        "v0",
        "v1",
        "a0",
        "a1",
        "a2",
        "a3",
        "t0",
        "t1",
        "t2",
        "t3",
        "t4",
        "t5",
        "t6",
        "t7",
        "s0",
        "s1",
        "s2",
        "s3",
        "s4",
        "s5",
        "s6",
        "s7",
        "t8",
        "t9",
        "k0",
        "k1",
        "gp",
        "sp",
        "fp",
        "ra",
        "hi",
        "lo"
      ],
      "type": "string"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "image_sha256": {
          "description": "The image's identity as the producer reports it (for psx, the media\nidentity of `psx context`).",
          "type": "string"
        },
        "platform": {
          "description": "The producer's platform: `psx`.",
          "type": "string"
        },
        "title": {
          "description": "The release, in words: `Croc (Europe) SLES-00593`.",
          "type": "string"
        }
      },
      "required": [
        "platform",
        "title",
        "image_sha256"
      ],
      "type": "object"
    },
    "Unobserved": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string"
        },
        "unobserved": {
          "description": "Always `true`: the field is not in memory the producer can read.\nReplay does not compare it.",
          "type": "boolean"
        }
      },
      "required": [
        "unobserved",
        "reason"
      ],
      "type": "object"
    },
    "Value": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "pattern": "^-?[0-9]+$",
          "type": "string"
        },
        {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/Value"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          },
          "type": "object"
        }
      ],
      "description": "A raw value: true/false; an integer (an int, a fixed's underlying integer, a float's bit pattern), as a decimal string outside ±2^53; a variant name; a table's or list's elements; or a record's fields."
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A binding, generic over the platform's location (`L`), call site (`S`)\nand capture bracket (`C`).",
  "properties": {
    "capture": {
      "$ref": "#/$defs/Capture"
    },
    "inputs": {
      "additionalProperties": {
        "$ref": "#/$defs/Read"
      },
      "description": "Every input, as the step sees it.",
      "type": "object"
    },
    "interfaces": {
      "additionalProperties": {
        "additionalProperties": {
          "$ref": "#/$defs/CallBinding"
        },
        "type": "object"
      },
      "description": "`\"<id>@<version>\"` -> call -> how capture sees the call.",
      "type": "object"
    },
    "mechanic": {
      "type": "string"
    },
    "mechanic_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "params": {
      "additionalProperties": {
        "$ref": "#/$defs/Param"
      },
      "description": "Every param: its value, or where capture reads it once, at the first\nstep's start.",
      "type": "object"
    },
    "params_provenance": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Where each param's value comes from, in words.",
      "type": "object"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "state": {
      "additionalProperties": {
        "$ref": "#/$defs/Encoding"
      },
      "description": "Every state field: where it is, or why it cannot be read.",
      "type": "object"
    }
  },
  "required": [
    "mechanic",
    "mechanic_version",
    "source",
    "capture"
  ],
  "title": "binding.toml",
  "type": "object"
}
