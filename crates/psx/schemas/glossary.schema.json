{
  "$defs": {
    "Endian": {
      "enum": [
        "big",
        "little"
      ],
      "type": "string"
    },
    "Field": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "int"
              }
            }
          },
          "then": {
            "required": [
              "bits",
              "signed"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fixed"
              }
            }
          },
          "then": {
            "required": [
              "signed",
              "int_bits",
              "frac_bits"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            }
          },
          "then": {
            "required": [
              "variants"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "float"
              }
            }
          },
          "then": {
            "required": [
              "bits"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            }
          },
          "then": {
            "required": [
              "of",
              "len"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "list"
              }
            }
          },
          "then": {
            "required": [
              "of"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "record"
              }
            }
          },
          "then": {
            "required": [
              "fields"
            ]
          }
        }
      ],
      "description": "A field's declared type, as written in `mechanic.toml` and interfaces.\nWhich keys apply depends on `type`; [`Field::ty`] checks them.",
      "properties": {
        "bits": {
          "description": "`int`: width in bits (1 to 64). `float`: 32, 64 or 80.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "additionalProperties": {
            "$ref": "#/$defs/Field"
          },
          "description": "`record`: its fields, by name.",
          "type": [
            "object",
            "null"
          ]
        },
        "frac_bits": {
          "description": "`fixed`: fraction bits; the raw value is the real value × 2^frac_bits.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "int_bits": {
          "description": "`fixed`: integer bits, the sign bit included.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "len": {
          "description": "`table`: the number of elements.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "of": {
          "anyOf": [
            {
              "$ref": "#/$defs/Field"
            },
            {
              "type": "null"
            }
          ],
          "description": "`table`, `list`: the element type (a table's is not itself a table)."
        },
        "signed": {
          "description": "`int`, `fixed`: whether the value is two's complement.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "type": {
          "$ref": "#/$defs/Kind"
        },
        "unit": {
          "description": "Documentation only: `\"units\"`, `\"units/tick\"`, `\"angle/4096\"`.",
          "type": [
            "string",
            "null"
          ]
        },
        "variants": {
          "description": "`enum`: the variants' names.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "Kind": {
      "oneOf": [
        {
          "enum": [
            "bool",
            "int",
            "fixed",
            "enum",
            "float"
          ],
          "type": "string"
        },
        {
          "const": "table",
          "description": "Params only: a fixed-length list of one element type.",
          "type": "string"
        },
        {
          "const": "list",
          "description": "Params only: a list of one element type, of any length.",
          "type": "string"
        },
        {
          "const": "record",
          "description": "Params only: named fields, each of its own type.",
          "type": "string"
        }
      ]
    },
    "Location": {
      "anyOf": [
        {
          "additionalProperties": false,
          "description": "Main RAM (any segment) or the scratchpad (0x1F800000).",
          "properties": {
            "address": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "address"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Relative to a register's value latched at the bracket's begin.",
          "properties": {
            "base": {
              "$ref": "#/$defs/Reg"
            },
            "offset": {
              "format": "int32",
              "type": "integer"
            }
          },
          "required": [
            "base",
            "offset"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A CPU register: at begin (inputs, params), at a call's entry\n(request) or return (response).",
          "properties": {
            "register": {
              "$ref": "#/$defs/Reg"
            }
          },
          "required": [
            "register"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A GTE register: data 0 to 31 as `mfc2` numbers them, control 32 to 63\n(`cfc2` n is 32 + n).",
          "properties": {
            "gte": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "gte"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Glossary quantities: the address held at `pointer`, plus `offset`,\nread anew each time (an object found through a pointer).",
          "properties": {
            "offset": {
              "format": "int32",
              "type": "integer"
            },
            "pointer": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "pointer",
            "offset"
          ],
          "type": "object"
        }
      ],
      "description": "Where a value is."
    },
    "Part": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "$ref": "#/$defs/Location"
        },
        "bytes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "at",
        "bytes"
      ],
      "type": "object"
    },
    "Read": {
      "additionalProperties": false,
      "description": "How a field's raw value is read: each part in order, first part most\nsignificant, then `mask`, `shift`, sign extension, rescaling and `map`.",
      "properties": {
        "endian": {
          "anyOf": [
            {
              "$ref": "#/$defs/Endian"
            },
            {
              "type": "null"
            }
          ],
          "description": "The parts' byte order; the platform's when left out."
        },
        "map": {
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          },
          "description": "`enum` (required) and `bool`: stored integer (decimal) -> value.",
          "type": [
            "object",
            "null"
          ]
        },
        "mask": {
          "anyOf": [
            {
              "$ref": "#/$defs/Value"
            },
            {
              "type": "null"
            }
          ],
          "description": "Applied to the concatenated parts, before `shift`."
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/Part"
          },
          "type": "array"
        },
        "shift": {
          "description": "Right shift after `mask`.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "stored_frac_bits": {
          "description": "`fixed`: the stored fraction bits, when they differ from the\nmechanic's. Capture refuses a rescale that loses bits.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "stored_signed": {
          "description": "Sign-extend from the read width (the mask's, or the parts').",
          "type": "boolean"
        },
        "stride": {
          "description": "Table params: bytes from one element to the next; the parts read\nthe first. Defaults to the parts' size.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "parts"
      ],
      "type": "object"
    },
    "Reg": {
      "description": "A CPU register, by its conventional name.",
      "enum": [
        "zero",
        "at",
        "v0",
        "v1",
        "a0",
        "a1",
        "a2",
        "a3",
        "t0",
        "t1",
        "t2",
        "t3",
        "t4",
        "t5",
        "t6",
        "t7",
        "s0",
        "s1",
        "s2",
        "s3",
        "s4",
        "s5",
        "s6",
        "s7",
        "t8",
        "t9",
        "k0",
        "k1",
        "gp",
        "sp",
        "fp",
        "ra",
        "hi",
        "lo"
      ],
      "type": "string"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "image_sha256": {
          "description": "The image's identity as the producer reports it (for psx, the media\nidentity of `psx context`).",
          "type": "string"
        },
        "platform": {
          "description": "The producer's platform: `psx`.",
          "type": "string"
        },
        "title": {
          "description": "The release, in words: `Croc (Europe) SLES-00593`.",
          "type": "string"
        }
      },
      "required": [
        "platform",
        "title",
        "image_sha256"
      ],
      "type": "object"
    },
    "Tick": {
      "additionalProperties": false,
      "description": "What ends one tick of the game's logic: a store to `at`, of `bytes`\nbytes, made by the instruction at `pc` when one is given.",
      "properties": {
        "at": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "bytes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pc": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "at",
        "bytes"
      ],
      "type": "object"
    },
    "Value": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "pattern": "^-?[0-9]+$",
          "type": "string"
        },
        {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/Value"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          },
          "type": "object"
        }
      ],
      "description": "A raw value: true/false; an integer (an int, a fixed's underlying integer, a float's bit pattern), as a decimal string outside ±2^53; a variant name; a table's or list's elements; or a record's fields."
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`glossary.toml`, generic over the platform's location (`L`) and tick\n(`T`).",
  "properties": {
    "bindings": {
      "additionalProperties": {
        "$ref": "#/$defs/Read"
      },
      "description": "Where the original keeps each quantity.",
      "type": "object"
    },
    "quantities": {
      "additionalProperties": {
        "$ref": "#/$defs/Field"
      },
      "default": {},
      "description": "Each quantity's type, unit and meaning, in game terms.",
      "type": "object"
    },
    "source": {
      "$ref": "#/$defs/Source",
      "description": "The release the bindings are for."
    },
    "tick": {
      "$ref": "#/$defs/Tick",
      "description": "What ends one tick of the game's logic: quantities are read there."
    }
  },
  "required": [
    "source",
    "tick"
  ],
  "title": "glossary.toml",
  "type": "object"
}
