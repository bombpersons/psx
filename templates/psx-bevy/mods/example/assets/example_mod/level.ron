// The example mod's arena (example_mod::Arena): a floor plus level data in
// the engine's format. Type 1 is the game's player, 2 the game's spinner
// (replaced by the mod: it turns twice as fast), 100 the mod's beacon
// (params: [amplitude in mm]).
(
    floor_half_size: 8.0,
    floor_colour: (0.5, 0.45, 0.65),
    level: (
        objects: [
            (type_id: (1), position: (0.0, 0.5, 2.0)),
            (type_id: (2), position: (-2.5, 1.0, -1.5), params: [1000, 0]),
            (type_id: (100), position: (2.5, 1.2, -1.5), params: [300]),
            (type_id: (100), position: (0.0, 1.5, -4.0), params: [500]),
        ],
        triggers: [],
    ),
)
