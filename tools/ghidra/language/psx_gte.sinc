:mtc2 RTsrc, "VXY0" is $(AMODE) & prime=0x12 & copop=4 & rd=0 & RTsrc { gte_set_VXY0(RTsrc); }
:mfc2 RT, "VXY0" is $(AMODE) & prime=0x12 & copop=0 & rd=0 & RT { tmp:4 = gte_get_VXY0(); RT = sext(tmp); }
:lwc2 "VXY0", OFF_BASE is $(AMODE) & REL6=0 & prime=0x32 & rt=0 & OFF_BASE { gte_set_VXY0(*[ram]:4 OFF_BASE); }
:swc2 "VXY0", OFF_BASE is $(AMODE) & REL6=0 & prime=0x3A & rt=0 & OFF_BASE { tmp:4 = gte_get_VXY0(); *[ram]:4 OFF_BASE = tmp; }
